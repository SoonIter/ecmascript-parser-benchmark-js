{
  "name": "ecmascript-parser-benchmark-js",
  "type": "module",
  "private": true,
  "scripts": {
    "bench": "bun scripts/bench.ts && bun readme",
    "load-files": "bun scripts/load-files.ts",
    "bench:typescript": "bun scripts/bench.ts typescript",
    "bench:checker": "bun scripts/bench.ts checker",
    "bench:lib_dom": "bun scripts/bench.ts lib_dom",
    "bench:react": "bun scripts/bench.ts react",
    "readme": "bun scripts/generate-readme.ts",
    "update-parsers": "bun update --latest --force",
    "type-check": "tsgo --noEmit"
  },
  "dependencies": {
    "@babel/parser": "^8.0.8",
    "@swc-next/parser": "^0.4.0",
    "@swc/core": "^1.16.20",
    "acorn": "^8.19.0",
    "oxc-parser": "^0.155.0",
    "tinybench": "^6.2.2",
    "yuku": "^0.24.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.5",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  }
}
